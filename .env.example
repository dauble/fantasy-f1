# Anthropic API Key for AI Predictions
# Get your key at: https://console.anthropic.com/
# Required for the AI-powered Predictions feature
# Keep this secret - never commit the actual .env file!
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Public URL for the application (used in meta tags, canonical URLs, etc.)
# This should be the full URL where the app is deployed
# Examples: https://fantasy-f1-hn8mhg.fly.dev, https://yourdomain.com
VITE_PUBLIC_URL=https://fantasy-f1-hn8mhg.fly.dev

# ── News Integration (optional) ────────────────────────────────────────────────
# Enable/disable individual news sources (defaults to true)
NEWS_PLANETF1_ENABLED=true
NEWS_MOTORSPORT_ENABLED=true
NEWS_REDDIT_ENABLED=true

# Number of articles to pull from each source (default: 10)
NEWS_MAX_ARTICLES_PER_SOURCE=10

# How long to cache news results in minutes (default: 30)
NEWS_CACHE_TTL_MINUTES=30

# ── Cloudflare Worker driver data (optional) ───────────────────────────────────
# Base URL of the countdown-to-f1 project's Cloudflare Worker
# (see https://github.com/dauble/countdown-to-f1/blob/main/documentation/CLOUDFLARE_WORKER.md).
# It refreshes OpenF1 driver data daily into Cloudflare KV, so our server can
# read from that shared cache instead of calling OpenF1 directly.
# When unset, the server falls back to calling OpenF1 directly (still just one
# server-side call, cached for 5 minutes — not one call per browser).
# Example: https://f1-yoto-myo-worker.your-subdomain.workers.dev
CLOUDFLARE_WORKER_URL=